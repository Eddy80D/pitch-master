# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，禁止提交。
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MODEL_PRO=mimo-v2.6-pro
MODEL_FLASH=mimo-v2.6-flash
# 单次调用超时（秒）。解剖大仓库给足时间。
MIMO_TIMEOUT=180

# —— D2 答辩 / 报告 ——
# 现场默认 = 演示模式（Q6 裁决）：4 问 / 每问 45s / 介绍 30s
# 完整模式改为：QA_MAX_QUESTIONS=10 / QA_ANSWER_TIMEOUT_S=120 / INTRO_TIMEOUT_S=180
QA_MAX_QUESTIONS=4
QA_ANSWER_TIMEOUT_S=45
INTRO_TIMEOUT_S=30
INTERJECTION_ENABLED=False
REPORT_MODEL=mimo-v2.6-pro

# —— 支付 / 老板后台 ——
# 开发与评审演示可设 False 跳过收款；现场营业设 True
PAYMENT_REQUIRED=True
# 老板后台令牌；为空则 /api/admin/* 全部 404
ADMIN_TOKEN=change-me

# —— D3 营业版 ——
# 先尝后买：提交后零 token 预检，再收费
PRECHECK_ENABLED=True
PRICE_YUAN=19.9

# —— D3.5 营业打磨 ——
# 付款即开审，老板事后核验；False 回退人工放行
AUTO_APPROVE=True
MAX_ACTIVE_SESSIONS_PER_IP=3

# 开场 Hero 背景视频（45s 循环 mp4/webm ≤5MB）；为空则米白渐变
BG_VIDEO_URL=

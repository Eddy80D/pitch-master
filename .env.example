# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，禁止提交。
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MODEL_PRO=mimo-v2.6-pro
MODEL_FLASH=mimo-v2.6-flash
# 单次调用超时（秒）。解剖大仓库给足时间。
MIMO_TIMEOUT=180

# —— D2 答辩 / 报告 ——
# 服务端宽松兜底：4 问 / 每问 600s / 介绍 300s（前端不再显示倒计时）
# 需要更长答辩可调大 QA_MAX_QUESTIONS
QA_MAX_QUESTIONS=4
QA_ANSWER_TIMEOUT_S=600
INTRO_TIMEOUT_S=300
INTERJECTION_ENABLED=False
REPORT_MODEL=mimo-v2.6-pro

# —— 支付 / 老板后台 ——
# 开发与评审演示可设 False 跳过收款；现场营业设 True
PAYMENT_REQUIRED=True
# 老板后台令牌；为空则 /api/admin/* 全部 404
ADMIN_TOKEN=change-me

# —— D3 营业版 ——
# 先尝后买：付款前完成预检 + 解剖（消耗 token），再展示疑点悬念卡收费
PRECHECK_ENABLED=True
PRICE_YUAN=19.9

# —— D3.5 营业打磨 ——
# 默认人工放行（付款后 pending，老板放行才开审）；True 为付款即开审
AUTO_APPROVE=False
MAX_ACTIVE_SESSIONS_PER_IP=3

# 开场 Hero 背景视频（45s 循环 mp4/webm ≤5MB）；为空则米白渐变
BG_VIDEO_URL=

# 单 IP 每日免费解剖上限
PREPAY_ANALYZE_MAX_PER_IP=5
